{
  "name": "smart-train-trip",
  "description": "A modern, responsive web application for viewing SMART train schedules and ferry connections",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "keywords": [
    "SMART",
    "train",
    "schedule",
    "transit",
    "Sonoma-Marin"
  ],
  "author": "Jamie Ruderman",
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "."
  },
  "scripts": {
    "prebuild": "tsx scripts/transit/transform.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/seo/prerender.ts",
    "build-native": "npm run prebuild && tsc --noEmit && vite build --mode native",
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "update-build": "npm run update-transit && npm run build",
    "update-transit": "tsx scripts/updateTransitFeeds.ts",
    "regen-transit": "tsx scripts/transit/transform.ts",
    "sync": "npm run build-native && CAPACITOR_LIVE_RELOAD_URL= npx cap sync",
    "sync-live": "CAPACITOR_LIVE_RELOAD_URL=http://$(ipconfig getifaddr en0):3210 npx cap sync",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#11ab75' --splashBackgroundColor '#11ab75' --splashBackgroundColorDark '#14161A'",
    "open-android": "npx cap open android",
    "open-ios": "npx cap open ios",
    "version": "sh scripts/version.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.2",
    "capacitor-live-activity": "^8.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.462.0",
    "mapbox-gl": "^3.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "adm-zip": "^0.5.18",
    "autoprefixer": "^10.6.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  }
}
